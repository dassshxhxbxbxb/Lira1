{
  "expo": {
    "name": "Lira",
    "slug": "cycle-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cycletracker.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cycletracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFCF7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "8ae94582-7b2b-4ec5-bbcc-37dff247f4a5"
      },
      "activationApiUrl": "https://lira-flowcare-vfaonddx.fly.dev",
      "botUsername": "lowerBsk24_bot"
    },
    "owner": "ivan_bulychev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8ae94582-7b2b-4ec5-bbcc-37dff247f4a5"
    }
  }
}
